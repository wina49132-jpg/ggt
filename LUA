-- 5. Auto Coin Farm System
local autoFarmEnabled = false
local antiBanEnabled = false

createToggle("Auto Coin Farm", function(state)
    autoFarmEnabled = state
end)

createToggle("Anti-Ban Farm Protection", function(state)
    antiBanEnabled = state
end)

task.spawn(function()
    while true do
        task.wait(1)
        if autoFarmEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
                if leaderstats then
                    local coins = leaderstats:FindFirstChild("Coins") or leaderstats:FindFirstChild("Coin")
                    if coins and coins.Value >= 10 then
                        autoFarmEnabled = false
                        return
                    end
                end

                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoFarmEnabled then break end
                    if obj.Name == "Coin_Server" or obj.Name == "Coin" then
                        if obj:FindFirstChild("TouchInterest") or obj:IsA("BasePart") then
                            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                            if part and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local hrp = LocalPlayer.Character.HumanoidRootPart
                                local distance = (hrp.Position - part.Position).Magnitude
                                local speed = antiBanEnabled and 35 or 55
                                local timeTravel = distance / speed
                                
                                local tweenInfo = TweenInfo.new(timeTravel, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(hrp, tweenInfo, {CFrame = part.CFrame + Vector3.new(0, 2, 0)})
                                tween:Play()
                                tween.Completed:Wait()
                                
                                if antiBanEnabled then
                                    task.wait(math.random(30, 70) / 100)
                                else
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 6. Murderer Kill All System
local killAllEnabled = false
createToggle("Murderer Kill All", function(state)
    killAllEnabled = state
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if killAllEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local char = LocalPlayer.Character
                local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
                if knife then
                    if not char:FindFirstChild("Knife") then
                        LocalPlayer.Character.Humanoid:EquipTool(knife)
                    end
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local enemyHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                            if enemyHumanoid and enemyHumanoid.Health > 0 then
                                local hrp = player.Character.HumanoidRootPart
                                char.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, 1)
                                task.wait(0.1)
                                if knife:FindFirstChild("Stab") then
                                    knife.Stab:FireServer()
                                elseif knife:FindFirstChild("Remote") then
                                    knife.Remote:FireServer()
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

